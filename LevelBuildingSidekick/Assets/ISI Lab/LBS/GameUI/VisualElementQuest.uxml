<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/ISI%20Lab/LBS/Plugin/VisualElements/Styles/LBSstyle.uss?fileID=7433441132597879392&amp;guid=9614f5340894b3546b59d43b5f2be029&amp;type=3#LBSstyle" />
    <engine:VisualElement style="flex-grow: 1; align-self: stretch; height: auto; max-height: none; min-height: auto; color: rgb(255, 255, 255); flex-direction: row; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;">
        <engine:VisualElement name="And" style="flex-grow: 1; background-image: resource(&apos;Icons/Vectorial/QuestIcons/Quest=TrackAnd&apos;); -unity-background-scale-mode: scale-to-fit; align-self: stretch; flex-direction: row; align-content: auto; align-items: center; justify-content: flex-start; min-width: 24px; max-width: 24px;" />
        <engine:VisualElement name="Or" style="flex-grow: 1; background-image: resource(&apos;Icons/Vectorial/QuestIcons/Quest=TrackOr&apos;); -unity-background-scale-mode: scale-to-fit; align-self: stretch; flex-direction: row; align-content: auto; align-items: center; justify-content: flex-start; min-width: 24px; max-width: 24px;" />
        <engine:VisualElement name="Outer" style="flex-grow: 1; width: 18px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; height: 18px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(255, 255, 255, 0.8); border-right-color: rgba(255, 255, 255, 0.8); border-top-color: rgba(255, 255, 255, 0.8); border-bottom-color: rgba(255, 255, 255, 0.8); -unity-background-image-tint-color: rgb(56, 56, 56); background-color: rgba(55, 55, 55, 0); align-self: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <engine:VisualElement name="Inner" style="flex-grow: 1; background-color: rgb(255, 255, 255); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;" />
        </engine:VisualElement>
        <engine:Label text="Label" name="Action" style="margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; align-self: stretch; justify-content: flex-start; align-items: flex-start; flex-direction: row; flex-grow: 1; -unity-text-align: middle-left;" />
    </engine:VisualElement>
</engine:UXML>
